<?php

/**
 * @file
 * Update hooks for ICMS core functionality.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Implements hook_install().
 */
function icms_core_logic_install() {
  module_set_weight('icms_core_logic', 50);
}

