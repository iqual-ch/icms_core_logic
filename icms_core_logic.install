/**
 * Disable the responsive_preview module.
 */
function icms_core_logic_update_9001() {
  $module_handler = \Drupal::moduleHandler();
  if ($module_handler->moduleExists('responsive_preview')) {
    \Drupal::service('module_installer')->uninstall(['responsive_preview']);
    return (string) new TranslatableMarkup('Disabled the responsive_preview module.');
  }
  return (string) new TranslatableMarkup('The responsive_preview module was not installed.');
}

/**
 * Clear simple_sitemap base_url setting.
 */
function icms_core_logic_update_9002() {
  $config = \Drupal::configFactory()->getEditable('simple_sitemap.settings');
  $config->set('base_url', '');
  $config->save();
  return (string) new TranslatableMarkup('The simple_sitemap base_url was already empty.');
}

/**
 * Add fields to paragraph types.
 */
function icms_core_logic_update_9003() {

  $fieldNames = [
    'field_icms_buttons' => [
      'label' => 'Buttons',
      'settings' => [
        'handler' => 'default:paragraph',
        'handler_settings' => [
          'target_bundles' => ['icms_button_element'],
          'negate' => 0,
        ],
      ],
      'paragraphs' => [
        'icms_layout_downloads',
        'icms_layout_partnerships',
        'icms_layout_testimonials',
        'icms_layout_timeline',
      ],
    ],

    'field_icms_pretitle' => [
      'label' => 'PreTitle',
      'settings' => [],
      'paragraphs' => [
        'icms_layout_tabs',
        'icms_layout_call_to_action',
      ],
    ],

    'field_icms_title' => [
      'label' => 'Title',
      'settings' => [],
      'paragraphs' => [
        'icms_layout_call_to_action',
      ],
    ],

    'field_icms_title_weight' => [
      'label' => 'Title weight',
      'settings' => [],
      'paragraphs' => [
        'icms_layout_call_to_action',
      ],
    ],

    'field_icms_title_style' => [
      'label' => 'Title style',
      'settings' => [],
      'paragraphs' => [
        'icms_layout_call_to_action',
      ],
    ],

    'field_icms_subtitle' => [
      'label' => 'SubTitle',
      'settings' => [],
      'paragraphs' => [
        'icms_layout_call_to_action',
        'icms_layout_downloads',
      ],
    ],

    'field_icms_text' => [
      'label' => 'Text',
      'settings' => [],
      'paragraphs' => [
        'icms_layout_tabs',
        'icms_layout_testimonials',
      ],
    ],
  ];

  // Field order with weights for form display.
  $fieldOrder = [
    'field_icms_pretitle' => 0,
    'field_icms_title' => 1,
    'group_title_settings' => 2,
    'field_icms_text' => 3,
    'field_icms_media_elements' => 4,
    'field_icms_buttons' => 5,
  ];

  $log = "";
  foreach ($fieldNames as $fieldName => $fieldData) {
    $fieldStorage = FieldStorageConfig::loadByName('paragraph', $fieldName);
    foreach ($fieldData['paragraphs'] as $paragarphType) {
      $field = FieldConfig::loadByName('paragraph', $paragarphType, $fieldName);
      if (!$field) {
        $field = FieldConfig::create([
          'field_storage' => $fieldStorage,
          'bundle' => $paragarphType,
          'label' => $fieldData['label'],
          'required' => FALSE,
          'settings' => $fieldData['settings'],
        ]);
        $field->save();
        $log .= 'Added field ' . $fieldName . ' to paragraph ' . $paragarphType . ". \n";
      }

      // Add field to form display with proper weight.
      $formDisplay = EntityFormDisplay::load('paragraph.' . $paragarphType . '.default');
      if ($formDisplay) {
        if ($fieldName === 'field_icms_subtitle') {
          if ($formDisplay->getComponent($fieldName)) {
            $formDisplay->removeComponent($fieldName);
            $formDisplay->save();
            $log .= 'Removed ' . $fieldName . ' from form display for ' . $paragarphType . ". \n";
          }
          continue;
        }

        $component = $formDisplay->getComponent($fieldName);
        if (!$component) {
          $weight = $fieldOrder[$fieldName] ?? 10;
          $formDisplay->setComponent($fieldName, [
            'type' => $fieldStorage->getType() === 'entity_reference_revisions' ? 'paragraphs' : 'string_textfield',
            'weight' => $weight,
            'settings' => [],
            'third_party_settings' => [],
          ]);
          $formDisplay->save();
          $log .= 'Added ' . $fieldName . ' to form display for ' . $paragarphType . ' (weight: ' . $weight . "). \n";
        }
      }
    }
  }

  return $log ?: 'No changes were needed.';

}

/**
 * Install contact webform from config file.
 */
function icms_core_logic_update_9045() {
  $success = icms_core_logic_install_webform('webform.webform.contact', 'icms_core_logic');

  if ($success) {
    return new TranslatableMarkup('Installed contact webform.');
  }
  else {
    return new TranslatableMarkup('Failed to install contact webform. Check logs for details.');
  }
}

/**
 * Create the Webform Manager role.
 */
function icms_core_logic_update_9010() {
  if (Role::load('webform_manager')) {
    return (string) new TranslatableMarkup('The Webform Manager role already exists.');
  }

  if (!\Drupal::moduleHandler()->moduleExists('webform')) {
    return (string) new TranslatableMarkup('Skipped creating Webform Manager role because the webform module is not installed.');
  }

  $role = Role::create([
    'id' => 'webform_manager',
    'label' => 'Webform Manager',
    'weight' => -6,
    'is_admin' => FALSE,
  ]);

  $permissions = [
    'access any webform configuration',
    'access own webform configuration',
    'access webform help',
    'access webform overview',
    'access webform submission user',
    'administer webform',
    'administer webform element access',
    'administer webform overview',
    'administer webform submission',
    'create webform',
    'delete any webform',
    'delete any webform submission',
    'delete own webform',
    'delete own webform submission',
    'edit any webform',
    'edit any webform submission',
    'edit own webform',
    'edit own webform submission',
    'edit webform variants',
    'view any webform submission',
    'view own webform submission',
  ];

  foreach ($permissions as $permission) {
    $role->grantPermission($permission);
  }

  $role->save();

  return (string) new TranslatableMarkup('Created the Webform Manager role.');

}

/**
 * Set help text description on the table field (all languages).
 */
function icms_core_logic_update_9011() {
  $field = FieldConfig::loadByName('paragraph', 'icms_layout_table', 'field_icms_table');
  if (!$field) {
    return (string) new TranslatableMarkup('Field field_icms_table not found.');
  }

  $description_en = '<p>Insert an icon within the table by typing a keyword that starts with a colon, for example: <code>:check</code> or <code>:cross</code>. Icon list: <a href="https://lucide.dev/icons/" target="_blank" rel="noopener noreferrer">https://lucide.dev/icons/</a></p>' . "\r\n" . '<p>You can also insert system emojis by right-clicking in the field and opening the emoji picker.</p>';

  $field->setDescription($description_en);
  $field->save();

  // Set translated descriptions if locale module is available.
  if (\Drupal::moduleHandler()->moduleExists('locale')) {
    $translations = [
      'de' => '<p>Fügen Sie innerhalb der Tabelle ein Icon ein, indem Sie ein Schlüsselwort eingeben, das mit einem Doppelpunkt beginnt, zum Beispiel: <code>:check</code> oder <code>:cross</code>. Icon-Liste: <a href="https://lucide.dev/icons/" target="_blank" rel="noopener noreferrer">https://lucide.dev/icons/</a></p> <p>Sie können auch System-Emojis einfügen, indem Sie im Feld mit der rechten Maustaste klicken und die Emoji-Auswahl öffnen.</p>',
      'fr' => "<p>Insérez une icône dans le tableau en saisissant un mot-clé qui commence par deux-points, par exemple : <code>:check</code> ou <code>:cross</code>. Liste des icônes : <a href='https://lucide.dev/icons/' target='_blank' rel='noopener noreferrer'>https://lucide.dev/icons/</a></p> <p>Vous pouvez également insérer des emojis système en faisant un clic droit dans le champ puis en ouvrant le sélecteur d'emojis.</p>",
      'it' => "<p>Inserisci un'icona all'interno della tabella digitando una parola chiave che inizia con i due punti, per esempio: <code>:check</code> oppure <code>:cross</code>. Elenco icone: <a href='https://lucide.dev/icons/' target='_blank' rel='noopener noreferrer'>https://lucide.dev/icons/</a></p> <p>Puoi anche inserire emoji di sistema facendo clic con il tasto destro nel campo e aprendo il selettore emoji.</p>",
    ];

    $label_translations = [
      'de' => 'Tabelle',
      'fr' => 'Tableau',
      'it' => 'Tabella',
    ];

    $config_name = 'field.field.paragraph.icms_layout_table.field_icms_table';
    foreach ($translations as $langcode => $description) {
      $language_manager = \Drupal::languageManager();
      if ($language_manager->getLanguage($langcode)) {
        $config_translation = $language_manager->getLanguageConfigOverride($langcode, $config_name);
        $config_translation->set('description', $description);
        if (isset($label_translations[$langcode])) {
          $config_translation->set('label', $label_translations[$langcode]);
        }
        $config_translation->save();
      }
    }
  }

  return (string) new TranslatableMarkup('Updated table field description in all languages.');
}

/**
 * Convert Blokk.li options.
 */
function icms_core_logic_update_9012() {
  $conversions = [
    // icms_layout_text: textWidth -> width
    [
      'bundle' => 'icms_layout_text',
      'old_key' => 'textWidth',
      'new_key' => 'width',
      'value_map' => ['full' => 'wide'],
    ],
    // icms_layout_text_media: textWidth -> width
    [
      'bundle' => 'icms_layout_text_media',
      'old_key' => 'textWidth',
      'new_key' => 'width',
      'value_map' => ['full' => 'wide'],
    ],
    // icms_layout_text_media: reverseColumns -> alignHorizontalReduced
    [
      'bundle' => 'icms_layout_text_media',
      'old_key' => 'reverseColumns',
      'new_key' => 'alignHorizontalReduced',
      'value_map' => [1 => 'right', 0 => 'left'],
    ],
    // icms_layout_iframe: textWidth -> width
    [
      'bundle' => 'icms_layout_iframe',
      'old_key' => 'textWidth',
      'new_key' => 'width',
      'value_map' => ['full' => 'wide'],
    ],
    // icms_layout_hero_image: reverseColumns -> alignHorizontalFull
    [
      'bundle' => 'icms_layout_hero_image',
      'old_key' => 'reverseColumns',
      'new_key' => 'alignHorizontalFull',
      'value_map' => [1 => 'right', 0 => 'left'],
    ],
    // icms_timeline_element: reverseColumns -> alignHorizontalReduced
    [
      'bundle' => 'icms_timeline_element',
      'old_key' => 'reverseColumns',
      'new_key' => 'alignHorizontalReduced',
      'value_map' => [1 => 'right', 0 => 'left'],
    ],
  ];

  // Group conversions by bundle so each paragraph is loaded/saved once.
  $by_bundle = [];
  foreach ($conversions as $conversion) {
    $by_bundle[$conversion['bundle']][] = $conversion;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $count = 0;
  foreach ($by_bundle as $bundle => $bundle_conversions) {
    $ids = $storage->getQuery()
      ->condition('type', $bundle)
      ->accessCheck(FALSE)
      ->execute();

    foreach ($storage->loadMultiple($ids) as $paragraph) {
      $behavior = $paragraph->getAllBehaviorSettings();
      $blokkli_data = $behavior['paragraphs_blokkli_data'] ?? [];
      $changed = FALSE;

      foreach ($bundle_conversions as $conversion) {
        if (isset($blokkli_data[$conversion['old_key']])) {
          if (!array_key_exists($conversion['new_key'], $blokkli_data)) {
            $old_value = $blokkli_data[$conversion['old_key']];
            $blokkli_data[$conversion['new_key']] = $conversion['value_map'][$old_value] ?? $old_value;
          }
          unset($blokkli_data[$conversion['old_key']]);
          $changed = TRUE;
        }
      }

      if ($changed) {
        $paragraph->setBehaviorSettings('paragraphs_blokkli_data', $blokkli_data);
        $paragraph->save();
        $count++;
      }
    }
  }

  return (string) new TranslatableMarkup('Converted @count Blokk.li options.', ['@count' => $count]);
}

/**
 * Convert field_icms_link_style to buttonStyle option.
 */
function icms_core_logic_update_9013() {
  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $storage->getQuery()
    ->condition('type', 'icms_button_element')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($ids)) {
    return (string) new TranslatableMarkup('No icms_button_element paragraphs found.');
  }

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $paragraph) {
    if (!$paragraph->hasField('field_icms_link_style')) {
      continue;
    }

    $value = $paragraph->get('field_icms_link_style')->value;

    if ($value) {
      $blokkli_data = $paragraph->getAllBehaviorSettings()['paragraphs_blokkli_data'] ?? [];
      $blokkli_data['buttonStyle'] = $value;
      $paragraph->setBehaviorSettings('paragraphs_blokkli_data', $blokkli_data);
      $paragraph->save();
      $count++;
    }
  }

  return (string) new TranslatableMarkup('Converted @count field_icms_link_style values to buttonStyle Blokk.li option.', ['@count' => $count]);
}

/**
 * Convert Paragraph types.
 */
function icms_core_logic_update_9014() {
  $log = [];
  $log[] = _icms_core_logic_install_conversion_paragraph_bundles();
  $log[] = _icms_core_logic_convert_layout_flip_teasers();
  $tab_mapping = [];
  $log[] = _icms_core_logic_convert_tab_elements($tab_mapping);
  $log[] = _icms_core_logic_convert_layout_tabs($tab_mapping);
  $log = implode(' ', $log);
  return $log ?: (string) new TranslatableMarkup('No paragraph conversions were needed.');
}

/**
 * Install paragraph bundle config required by paragraph conversions.
 */
function _icms_core_logic_install_conversion_paragraph_bundles(): string {
  $config_entities = [
    'field_storage_config' => [
      'field.storage.paragraph.field_icms_collapsible_title',
      'field.storage.paragraph.field_icms_collapsible_layouts',
      'field.storage.paragraph.field_icms_collapsible_elements',
      'field.storage.paragraph.field_icms_link_list_elements',
      'field.storage.paragraph.field_icms_links',
    ],
    'paragraphs_type' => [
      'paragraphs.paragraphs_type.icms_collapsible_element',
      'paragraphs.paragraphs_type.icms_layout_collapsible',
      'paragraphs.paragraphs_type.icms_link_list_element',
      'paragraphs.paragraphs_type.icms_layout_link_lists',
    ],
    'field_config' => [
      'field.field.paragraph.icms_collapsible_element.field_icms_collapsible_title',
      'field.field.paragraph.icms_collapsible_element.field_icms_collapsible_layouts',
      'field.field.paragraph.icms_layout_collapsible.field_icms_pretitle',
      'field.field.paragraph.icms_layout_collapsible.field_icms_title',
      'field.field.paragraph.icms_layout_collapsible.field_icms_title_weight',
      'field.field.paragraph.icms_layout_collapsible.field_icms_title_style',
      'field.field.paragraph.icms_layout_collapsible.field_icms_subtitle',
      'field.field.paragraph.icms_layout_collapsible.field_icms_text',
      'field.field.paragraph.icms_layout_collapsible.field_icms_collapsible_elements',
      'field.field.paragraph.icms_link_list_element.field_icms_title',
      'field.field.paragraph.icms_link_list_element.field_icms_text',
      'field.field.paragraph.icms_link_list_element.field_icms_links',
      'field.field.paragraph.icms_layout_link_lists.field_icms_pretitle',
      'field.field.paragraph.icms_layout_link_lists.field_icms_title',
      'field.field.paragraph.icms_layout_link_lists.field_icms_title_weight',
      'field.field.paragraph.icms_layout_link_lists.field_icms_title_style',
      'field.field.paragraph.icms_layout_link_lists.field_icms_subtitle',
      'field.field.paragraph.icms_layout_link_lists.field_icms_text',
      'field.field.paragraph.icms_layout_link_lists.field_icms_link_list_elements',
    ],
    'entity_form_display' => [
      'core.entity_form_display.paragraph.icms_collapsible_element.default',
      'core.entity_form_display.paragraph.icms_layout_collapsible.default',
      'core.entity_form_display.paragraph.icms_link_list_element.default',
      'core.entity_form_display.paragraph.icms_layout_link_lists.default',
    ],
    'language_content_settings' => [
      'language.content_settings.paragraph.icms_collapsible_element',
      'language.content_settings.paragraph.icms_layout_collapsible',
      'language.content_settings.paragraph.icms_link_list_element',
      'language.content_settings.paragraph.icms_layout_link_lists',
    ],
    'graphql_servers' => [
      'graphql.graphql_servers.graphql',
    ],
  ];

  $created = 0;
  foreach ($config_entities as $entity_type_id => $config_names) {
    foreach ($config_names as $config_name) {
      $created += (int) _icms_core_logic_import_config_entity($config_name, $entity_type_id);
    }
  }

  if ($created > 0) {
    \Drupal::entityTypeManager()->clearCachedDefinitions();
    \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
    \Drupal::service('entity_type.bundle.info')->clearCachedBundles();
    \Drupal::service('config.factory')->reset('graphql.graphql_servers.graphql');
  }

  return (string) new TranslatableMarkup('Installed @count config entities required for paragraph conversions.', ['@count' => $created]);
}

/**
 * Install a missing config entity from module-bundled update YAML.
 */
function _icms_core_logic_import_config_entity(string $config_name, string $entity_type_id): bool {
  $active_storage = \Drupal::service('config.storage');
  if ($active_storage->exists($config_name)) {
    return FALSE;
  }

  $data = _icms_core_logic_read_exported_config($config_name);
  if (!$data) {
    \Drupal::logger('icms_core_logic')->warning('Skipped installing missing config entity @config because its bundled update YAML file could not be read.', ['@config' => $config_name]);
    return FALSE;
  }

  $storage = \Drupal::entityTypeManager()->getStorage($entity_type_id);
  $entity = $storage->createFromStorageRecord($data);
  $entity->save();

  return TRUE;
}

/**
 * Read a config entity from module-bundled update YAML.
 */
function _icms_core_logic_read_exported_config(string $config_name): ?array {
  $module_path = \Drupal::service('extension.list.module')->getPath('icms_core_logic');
  $config_path = DRUPAL_ROOT . '/' . $module_path . '/config/update/9014/' . $config_name . '.yml';

  if (!is_readable($config_path)) {
    return NULL;
  }

  $data = Yaml::parseFile($config_path);
  return is_array($data) ? $data : NULL;
}

/**
 * Convert icms_layout_flip_teasers to icms_layout_teasers.
 */
function _icms_core_logic_convert_layout_flip_teasers(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $storage->getQuery()
    ->condition('type', 'icms_layout_flip_teasers')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($ids)) {
    return (string) new TranslatableMarkup('No icms_layout_flip_teasers paragraphs found.');
  }

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $old_paragraph) {
    $parent = $old_paragraph->getParentEntity();
    $parent_field_name = $old_paragraph->get('parent_field_name')->value;

    if (!$parent) {
      \Drupal::logger('icms_core_logic')->notice('Skipping orphaned icms_layout_flip_teasers @id (no parent entity).', ['@id' => $old_paragraph->id()]);
      continue;
    }

    $new_paragraph = Paragraph::create([
      'type' => 'icms_layout_teasers',
      'langcode' => $old_paragraph->get('langcode')->value,
      'field_icms_pretitle' => $old_paragraph->get('field_icms_pretitle')->getValue(),
      'field_icms_title' => $old_paragraph->get('field_icms_title')->getValue(),
      'field_icms_title_weight' => $old_paragraph->get('field_icms_title_weight')->getValue(),
      'field_icms_title_style' => $old_paragraph->get('field_icms_title_style')->getValue(),
      'field_icms_subtitle' => $old_paragraph->get('field_icms_subtitle')->getValue(),
      'field_icms_text' => $old_paragraph->get('field_icms_text')->getValue(),
      'field_icms_content_entities' => $old_paragraph->get('field_icms_content_entities')->getValue(),
    ]);

    // Set teaserVariant blokkli option.
    $blokkli_data = $old_paragraph->getAllBehaviorSettings()['paragraphs_blokkli_data'] ?? [];
    $blokkli_data['teaserVariant'] = 'flipTeaser';
    $new_paragraph->setBehaviorSettings('paragraphs_blokkli_data', $blokkli_data);
    $new_paragraph->save();

    // Copy translations to new paragraph.
    $translations = $old_paragraph->getTranslationLanguages(FALSE);
    foreach ($translations as $langcode => $language) {
      $translated = $old_paragraph->getTranslation($langcode);
      $new_paragraph->addTranslation($langcode, [
        'field_icms_pretitle' => $translated->get('field_icms_pretitle')->getValue(),
        'field_icms_title' => $translated->get('field_icms_title')->getValue(),
        'field_icms_title_weight' => $translated->get('field_icms_title_weight')->getValue(),
        'field_icms_title_style' => $translated->get('field_icms_title_style')->getValue(),
        'field_icms_subtitle' => $translated->get('field_icms_subtitle')->getValue(),
        'field_icms_text' => $translated->get('field_icms_text')->getValue(),
        'field_icms_content_entities' => $translated->get('field_icms_content_entities')->getValue(),
      ]);
    }
    if (!empty($translations)) {
      $new_paragraph->save();
    }

    // Update parent reference.
    $items = $parent->get($parent_field_name)->getValue();
    foreach ($items as $delta => $item) {
      if ($item['target_id'] == $old_paragraph->id()) {
        $items[$delta]['target_id'] = $new_paragraph->id();
        $items[$delta]['target_revision_id'] = $new_paragraph->getRevisionId();
      }
    }
    $parent->set($parent_field_name, $items);
    $parent->save();

    $old_paragraph->delete();
    $count++;
  }

  return (string) new TranslatableMarkup('Converted @count icms_layout_flip_teasers to icms_layout_teasers.', ['@count' => $count]);
}

/**
 * Convert icms_tab_element → icms_collapsible_element.
 *
 * Does not touch the parent (layout_tabs) — _icms_core_logic_convert_layout_tabs handles rewiring.
 * Populates $mapping with old_tab_element_id => new collapsible_element ref.
 */
function _icms_core_logic_convert_tab_elements(array &$mapping): string {
  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $storage->getQuery()
    ->condition('type', 'icms_tab_element')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($ids)) {
    return (string) new TranslatableMarkup('No icms_tab_element paragraphs found.');
  }

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $old_paragraph) {
    // Create layout_text_media if media exists, otherwise layout_text.
    $media_values = $old_paragraph->get('field_icms_media_elements')->getValue();
    $fields = [
      'field_icms_pretitle' => $old_paragraph->get('field_icms_pretitle')->getValue(),
      'field_icms_title' => $old_paragraph->get('field_icms_title')->getValue(),
      'field_icms_title_style' => $old_paragraph->get('field_icms_title_style')->getValue(),
      'field_icms_subtitle' => $old_paragraph->get('field_icms_subtitle')->getValue(),
      'field_icms_text' => $old_paragraph->get('field_icms_text')->getValue(),
      'field_icms_buttons' => $old_paragraph->get('field_icms_buttons')->getValue(),
    ];

    $fields['langcode'] = $old_paragraph->get('langcode')->value;

    if (!empty($media_values)) {
      $fields['type'] = 'icms_layout_text_media';
      $fields['field_icms_media_elements'] = $media_values;
    }
    else {
      $fields['type'] = 'icms_layout_text';
    }

    $child = Paragraph::create($fields);
    $child->save();

    // Copy translations to child paragraph.
    $translations = $old_paragraph->getTranslationLanguages(FALSE);
    foreach ($translations as $langcode => $language) {
      $translated = $old_paragraph->getTranslation($langcode);
      $child_translation = [
        'field_icms_pretitle' => $translated->get('field_icms_pretitle')->getValue(),
        'field_icms_title' => $translated->get('field_icms_title')->getValue(),
        'field_icms_title_style' => $translated->get('field_icms_title_style')->getValue(),
        'field_icms_subtitle' => $translated->get('field_icms_subtitle')->getValue(),
        'field_icms_text' => $translated->get('field_icms_text')->getValue(),
        'field_icms_buttons' => $translated->get('field_icms_buttons')->getValue(),
      ];
      if ($child->bundle() === 'icms_layout_text_media') {
        $child_translation['field_icms_media_elements'] = $translated->get('field_icms_media_elements')->getValue();
      }
      $child->addTranslation($langcode, $child_translation);
    }
    if (!empty($translations)) {
      $child->save();
    }

    // Create the new collapsible_element.
    $new_paragraph = Paragraph::create([
      'type' => 'icms_collapsible_element',
      'langcode' => $old_paragraph->get('langcode')->value,
    ]);
    $new_paragraph->save();
    $new_paragraph->set('field_icms_collapsible_title', $old_paragraph->get('field_icms_tab_title')->getValue());
    $new_paragraph->set('field_icms_collapsible_layouts', [$child]);
    $new_paragraph->save();

    // Copy translations to collapsible_element.
    foreach ($translations as $langcode => $language) {
      $translated = $old_paragraph->getTranslation($langcode);
      $new_paragraph->addTranslation($langcode, [
        'field_icms_collapsible_title' => $translated->get('field_icms_tab_title')->getValue(),
      ]);
    }
    if (!empty($translations)) {
      $new_paragraph->save();
    }

    // Store mapping for _icms_core_logic_convert_layout_tabs to use.
    $mapping[$old_paragraph->id()] = [
      'target_id' => $new_paragraph->id(),
      'target_revision_id' => $new_paragraph->getRevisionId(),
    ];
    $count++;
  }

  return (string) new TranslatableMarkup('Converted @count icms_tab_element to icms_collapsible_element.', ['@count' => $count]);
}

/**
 * Convert icms_layout_tabs → icms_layout_collapsible.
 *
 * Uses $tab_mapping from _icms_core_logic_convert_tab_elements to rewire tab_elements → collapsible_elements.
 * Also cleans up old tab_elements.
 */
function _icms_core_logic_convert_layout_tabs(array $tab_mapping): string {
  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $storage->getQuery()
    ->condition('type', 'icms_layout_tabs')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($ids)) {
    return (string) new TranslatableMarkup('No icms_layout_tabs paragraphs found.');
  }

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $old_paragraph) {
    $parent = $old_paragraph->getParentEntity();
    $parent_field_name = $old_paragraph->get('parent_field_name')->value;

    if (!$parent) {
      \Drupal::logger('icms_core_logic')->notice('Skipping orphaned icms_layout_tabs @id (no parent entity).', ['@id' => $old_paragraph->id()]);
      continue;
    }

    // Map old tab_element refs to new collapsible_element refs.
    $collapsible_elements = [];
    $old_tab_ids = [];
    foreach ($old_paragraph->get('field_icms_tab_elements')->getValue() as $ref) {
      $old_id = $ref['target_id'];
      $old_tab_ids[] = $old_id;
      if (isset($tab_mapping[$old_id])) {
        $collapsible_elements[] = $tab_mapping[$old_id];
      }
    }

    // Log if any referenced tab elements had no mapping (stale references).
    if (count($collapsible_elements) !== count($old_tab_ids)) {
      \Drupal::logger('icms_core_logic')->warning('icms_layout_tabs @id: @dropped stale tab element references dropped.', [
        '@id' => $old_paragraph->id(),
        '@dropped' => count($old_tab_ids) - count($collapsible_elements),
      ]);
    }

    $new_paragraph = Paragraph::create([
      'type' => 'icms_layout_collapsible',
      'langcode' => $old_paragraph->get('langcode')->value,
    ]);
    $new_paragraph->save();
    $new_paragraph->set('field_icms_pretitle', $old_paragraph->get('field_icms_pretitle')->getValue());
    $new_paragraph->set('field_icms_title', $old_paragraph->get('field_icms_title')->getValue());
    $new_paragraph->set('field_icms_title_weight', $old_paragraph->get('field_icms_title_weight')->getValue());
    $new_paragraph->set('field_icms_title_style', $old_paragraph->get('field_icms_title_style')->getValue());
    $new_paragraph->set('field_icms_text', $old_paragraph->get('field_icms_text')->getValue());
    $new_paragraph->set('field_icms_collapsible_elements', $collapsible_elements);
    $new_paragraph->save();

    // Set collapsibleVariant blokkli option.
    $blokkli_data = $old_paragraph->getAllBehaviorSettings()['paragraphs_blokkli_data'] ?? [];
    $blokkli_data['collapsibleVariant'] = 'tabs';
    $new_paragraph->setBehaviorSettings('paragraphs_blokkli_data', $blokkli_data);
    $new_paragraph->save();

    // Copy translations to new paragraph.
    $translations = $old_paragraph->getTranslationLanguages(FALSE);
    foreach ($translations as $langcode => $language) {
      $translated = $old_paragraph->getTranslation($langcode);
      $new_paragraph->addTranslation($langcode, [
        'field_icms_pretitle' => $translated->get('field_icms_pretitle')->getValue(),
        'field_icms_title' => $translated->get('field_icms_title')->getValue(),
        'field_icms_title_weight' => $translated->get('field_icms_title_weight')->getValue(),
        'field_icms_title_style' => $translated->get('field_icms_title_style')->getValue(),
        'field_icms_text' => $translated->get('field_icms_text')->getValue(),
      ]);
    }
    if (!empty($translations)) {
      $new_paragraph->save();
    }

    // Update parent reference.
    $items = $parent->get($parent_field_name)->getValue();
    foreach ($items as $delta => $item) {
      if ($item['target_id'] == $old_paragraph->id()) {
        $items[$delta]['target_id'] = $new_paragraph->id();
        $items[$delta]['target_revision_id'] = $new_paragraph->getRevisionId();
      }
    }
    $parent->set($parent_field_name, $items);
    $parent->save();

    // Clean up old tab_elements and layout_tabs.
    foreach ($storage->loadMultiple($old_tab_ids) as $old_tab) {
      $old_tab->delete();
    }
    $old_paragraph->delete();
    $count++;
  }

  return (string) new TranslatableMarkup('Converted @count icms_layout_tabs to icms_layout_collapsible.', ['@count' => $count]);
}

/**
 * Delete obsolete paragraph types and associated config.
 */
function icms_core_logic_update_9015() {
  $config_factory = \Drupal::configFactory();
  $log = '';
  $obsolete_types = ['icms_layout_tabs', 'icms_tab_element', 'icms_layout_flip_teasers'];

  // Delete any remaining paragraphs of obsolete types
  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  foreach ($obsolete_types as $type) {
    $ids = $storage->getQuery()
      ->condition('type', $type)
      ->accessCheck(FALSE)
      ->execute();
    if (!empty($ids)) {
      $storage->delete($storage->loadMultiple($ids));
      $log .= (string) new TranslatableMarkup('Deleted @count remaining @type paragraphs.', ['@count' => count($ids), '@type' => $type]) . ' ';
    }
  }

  $configs = [
    // icms_layout_tabs.
    'field.field.paragraph.icms_layout_tabs.field_icms_text',
    'field.field.paragraph.icms_layout_tabs.field_icms_tab_elements',
    'field.field.paragraph.icms_layout_tabs.field_icms_pretitle',
    'field.field.paragraph.icms_layout_tabs.field_icms_title',
    'field.field.paragraph.icms_layout_tabs.field_icms_title_style',
    'field.field.paragraph.icms_layout_tabs.field_icms_title_weight',
    'core.entity_form_display.paragraph.icms_layout_tabs.default',
    'core.entity_view_display.paragraph.icms_layout_tabs.default',
    'language.content_settings.paragraph.icms_layout_tabs',
    'paragraphs.paragraphs_type.icms_layout_tabs',

    // icms_tab_element.
    'field.field.paragraph.icms_tab_element.field_icms_buttons',
    'field.field.paragraph.icms_tab_element.field_icms_pretitle',
    'field.field.paragraph.icms_tab_element.field_icms_subtitle',
    'field.field.paragraph.icms_tab_element.field_icms_tab_title',
    'field.field.paragraph.icms_tab_element.field_icms_text',
    'field.field.paragraph.icms_tab_element.field_icms_title',
    'field.field.paragraph.icms_tab_element.field_icms_title_style',
    'field.field.paragraph.icms_tab_element.field_icms_media_elements',
    'core.entity_form_display.paragraph.icms_tab_element.default',
    'core.entity_view_display.paragraph.icms_tab_element.default',
    'language.content_settings.paragraph.icms_tab_element',
    'paragraphs.paragraphs_type.icms_tab_element',

    // icms_layout_flip_teasers.
    'field.field.paragraph.icms_layout_flip_teasers.field_icms_content_entities',
    'field.field.paragraph.icms_layout_flip_teasers.field_icms_pretitle',
    'field.field.paragraph.icms_layout_flip_teasers.field_icms_subtitle',
    'field.field.paragraph.icms_layout_flip_teasers.field_icms_text',
    'field.field.paragraph.icms_layout_flip_teasers.field_icms_title',
    'field.field.paragraph.icms_layout_flip_teasers.field_icms_title_style',
    'field.field.paragraph.icms_layout_flip_teasers.field_icms_title_weight',
    'core.entity_form_display.paragraph.icms_layout_flip_teasers.default',
    'core.entity_view_display.paragraph.icms_layout_flip_teasers.default',
    'language.content_settings.paragraph.icms_layout_flip_teasers',
    'paragraphs.paragraphs_type.icms_layout_flip_teasers',
  ];

  $count = 0;
  foreach ($configs as $config_name) {
    $config = $config_factory->getEditable($config_name);
    if (!$config->isNew()) {
      $config->delete();
      $count++;
    }
  }
  $log .= (string) new TranslatableMarkup('Deleted @count config objects.', ['@count' => $count]);

  // Delete field storages only used by obsolete bundles.
  foreach (['field_icms_tab_title', 'field_icms_tab_elements'] as $field_name) {
    $field_storage = FieldStorageConfig::loadByName('paragraph', $field_name);
    if ($field_storage && empty($field_storage->getBundles())) {
      $field_storage->delete();
      $log .= ' ' . (string) new TranslatableMarkup('Deleted @field field storage.', ['@field' => $field_name]);
    }
  }

  $bundle_field_map = \Drupal::keyValue('entity.definitions.bundle_field_map')->get('paragraph', []);
  $bundle_map_updated = FALSE;
  foreach ($bundle_field_map as &$entry) {
    if (empty($entry['bundles']) || !is_array($entry['bundles'])) {
      continue;
    }

    foreach ($obsolete_types as $obsolete_type) {
      if (isset($entry['bundles'][$obsolete_type])) {
        unset($entry['bundles'][$obsolete_type]);
        $bundle_map_updated = TRUE;
      }
    }
  }
  unset($entry);

  if ($bundle_map_updated) {
    \Drupal::keyValue('entity.definitions.bundle_field_map')->set('paragraph', $bundle_field_map);
    \Drupal::entityTypeManager()->clearCachedDefinitions();
    \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
    \Drupal::service('entity_type.bundle.info')->clearCachedBundles();
    $log .= ' ' . (string) new TranslatableMarkup('Removed obsolete paragraph bundles from the persistent field map.');
  }

  return $log;
}

/**
 * Explicitly set Layout Call to Action's callToActionVariant based on media.
 */
function icms_core_logic_update_9016() {
  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $storage->getQuery()
    ->condition('type', 'icms_layout_call_to_action')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($ids)) {
    return (string) new TranslatableMarkup('No icms_layout_call_to_action paragraphs found.');
  }

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $paragraph) {
    $has_media = !$paragraph->get('field_icms_media_element')->isEmpty();
    $variant = $has_media ? 'feature' : 'default';

    $blokkli_data = $paragraph->getAllBehaviorSettings()['paragraphs_blokkli_data'] ?? [];
    if (!array_key_exists('callToActionVariant', $blokkli_data)) {
      $blokkli_data['callToActionVariant'] = $variant;
      $paragraph->setBehaviorSettings('paragraphs_blokkli_data', $blokkli_data);
      $paragraph->save();
      $count++;
    }
  }

  return (string) new TranslatableMarkup('Set callToActionVariant on @count paragraphs.', ['@count' => $count]);
}

/**
 * Grant the new "flush cache" permission to roles that could flush before.
 *
 * The admin_toolbar patch changed from loosening the flush routes to
 * "access administration pages" to the upstream approach of a dedicated
 * "flush cache" permission (https://drupal.org/i/3517876). Grant it to the
 * roles that previously had flush access so the toolbar entries keep working.
 */
function icms_core_logic_update_9046() {
  if (!\Drupal::moduleHandler()->moduleExists('admin_toolbar_tools')) {
    return (string) new TranslatableMarkup('Skipped granting "flush cache" because admin_toolbar_tools is not installed.');
  }

  $granted = [];
  foreach (['administrator_client', 'content_editor'] as $role_id) {
    $role = Role::load($role_id);
    if ($role && !$role->hasPermission('flush cache')) {
      $role->grantPermission('flush cache');
      $role->save();
      $granted[] = $role_id;
    }
  }

  if (!$granted) {
    return (string) new TranslatableMarkup('No roles needed the "flush cache" permission.');
  }
  return (string) new TranslatableMarkup('Granted "flush cache" to: @roles.', ['@roles' => implode(', ', $granted)]);
}

/**
 * Enable multi-image upload via media_bulk_upload and optional alt text.
 */
function icms_core_logic_update_9047() {
  $messages = [];
  $module_installer = \Drupal::service('module_installer');
  $module_handler = \Drupal::moduleHandler();

  if (!$module_handler->moduleExists('media_bulk_upload')) {
    $module_installer->install(['media_bulk_upload']);
    $messages[] = 'Installed media_bulk_upload module.';
  }
  else {
    $messages[] = 'media_bulk_upload module was already installed.';
  }

  // Provide a bulk upload form for image media. Values mirror the exported
  // media_bulk_upload.media_bulk_config.images.yml.
  $entity_type_manager = \Drupal::entityTypeManager();
  $has_media_library_form_mode = (bool) $entity_type_manager
    ->getStorage('entity_form_mode')
    ->load('media.media_library');
  $settings = [
    'media_types' => [
      'image' => 'image',
      'audio' => 0,
      'document' => 0,
      'icon' => 0,
      'remote_video' => 0,
      'video' => 0,
    ],
    'form_mode' => $has_media_library_form_mode ? 'media_library' : 'default',
    'upload_location' => 'private://media-bulk-upload',
  ];
  $storage = $entity_type_manager->getStorage('media_bulk_config');
  $bulk_config = $storage->load('images');
  if (!$bulk_config) {
    $storage->create([
      'id' => 'images',
      'label' => 'Images',
    ] + $settings)->save();
    $messages[] = 'Created images bulk upload form.';
  }
  else {
    foreach ($settings as $key => $value) {
      $bulk_config->set($key, $value);
    }
    $bulk_config->save();
    $messages[] = 'Updated images bulk upload form.';
  }

  // Alt text can not be entered per file during bulk upload, so it must be
  // optional for bulk-created image media to validate.
  $field = FieldConfig::load('media.image.field_media_image');
  if ($field && $field->getSetting('alt_field_required')) {
    $field->setSetting('alt_field_required', FALSE);
    $field->save();
    $messages[] = 'Made image alt text optional.';
  }

  foreach (['content_editor', 'administrator_client'] as $role_id) {
    $role = Role::load($role_id);
    if ($role && !$role->hasPermission('use images bulk upload form')) {
      $role->grantPermission('use images bulk upload form');
      $role->save();
      $messages[] = "Granted bulk upload permission to $role_id.";
    }
  }

  return (string) new TranslatableMarkup(implode(' ', $messages));
}

/**
 * Helper function to install a webform from a YAML config file.
 *
 * This shared utility can be used by any module that needs to install webforms
 * programmatically from config files, keeping the code DRY.
 *
 * @param string $config_name
 *   The config name (e.g., 'webform.webform.contact').
 * @param string $module_name
 *   The module name where the config file is located.
 *
 * @return bool
 *   TRUE if successful, FALSE otherwise.
 */
function icms_core_logic_install_webform($config_name, $module_name) {
  // Check if webform module is installed.
  if (!\Drupal::moduleHandler()->moduleExists('webform')) {
    \Drupal::logger($module_name)->warning(
      'Webform module not installed yet, skipping webform installation for @config',
      ['@config' => $config_name]
    );
    return FALSE;
  }

  try {
    // Extract webform ID from config name.
    $webform_id = str_replace('webform.webform.', '', $config_name);

    // Check if webform already exists.
    $webform_storage = \Drupal::entityTypeManager()->getStorage('webform');
    $existing_webform = $webform_storage->load($webform_id);

    if ($existing_webform) {
      \Drupal::logger($module_name)->info(
        'Webform @id already exists, skipping installation.',
        ['@id' => $webform_id]
      );
      return TRUE;
    }

    // Load the YAML file from the module's config directory.
    $module_path = \Drupal::service('extension.list.module')->getPath($module_name);
    $config_file = $module_path . '/config/install/' . $config_name . '.yml';

    if (!file_exists($config_file)) {
      \Drupal::logger($module_name)->error(
        'Webform config file not found: @file',
        ['@file' => $config_file]
      );
      return FALSE;
    }

    // Parse the YAML file.
    $config_data = Yaml::parseFile($config_file);

    if (empty($config_data)) {
      \Drupal::logger($module_name)->error(
        'Failed to parse webform config file: @file',
        ['@file' => $config_file]
      );
      return FALSE;
    }

    // Remove UUID and other deployment-specific keys.
    unset($config_data['uuid']);
    unset($config_data['_core']);

    // Create the webform entity.
    $webform = $webform_storage->create($config_data);
    $webform->save();

    \Drupal::logger($module_name)->info(
      'Successfully installed webform: @id',
      ['@id' => $webform_id]
    );

    return TRUE;
  }
  catch (\Exception $e) {
    \Drupal::logger($module_name)->error(
      'Error installing webform @config: @message',
      [
        '@config' => $config_name,
        '@message' => $e->getMessage(),
      ]
    );
    return FALSE;
  }
}
