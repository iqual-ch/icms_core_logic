<?php

/**
 * @file
 * Install hooks for the ICMS core logic update test module.
 */

/**
 * Implements hook_install().
 */
function icms_core_logic_update_test_install(): void {
  // Fails after the module installer rebuilt the container.
  if (\Drupal::state()->get('icms_core_logic_update_test.fail_install')) {
    throw new \RuntimeException('icms_core_logic_update_test failed to install.');
  }
}
