<?php

/**
 * @file
 * Runtime hooks and callbacks for ICMS core.
 */

use Drupal\Core\Cache\RefinableCacheableDependencyInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Url;
use Drupal\node\Entity\NodeType;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;

/**
 * Allowed values callback listing every content type by machine name.
 *
 * Backs field_icms_content_types on the listing paragraph, so editors pick
 * the content types a listing shows and bundles installed later appear
 * without a config change.
 */
function icms_core_logic_content_types_allowed_values(FieldStorageDefinitionInterface $definition, ?FieldableEntityInterface $entity = NULL, bool &$cacheable = TRUE): array {
  $options = [];
  foreach (NodeType::loadMultiple() as $type) {
    $options[$type->id()] = (string) $type->label();
  }
  natcasesort($options);
  return $options;
}

/**
 * The longest username ICMS stores, and the single source of that number.
 *
 * `users_field_data.name` is `varchar(60)` with a unique index, while an email
 * address may be up to 254 characters — so the address cannot simply be used
 * as-is; a long one would abort the save with a database exception.
 *
 * Two characters below the column width are held back for the suffix
 * email_registration_unique_username() appends when a shortened name collides
 * with an account that already exists. It counts up without a bound, so the
 * reserve covers "_1" through "_9": a shortened address shared by a tenth
 * account would overflow again. That needs ten accounts whose addresses agree
 * on their first 58 characters, which is why the reserve stops there rather
 * than growing to fit an arbitrary number.
 *
 * Anything deriving this limit reads it from here instead of repeating the
 * number; the upgrade guide quotes it as 58.
 *
 * @return int
 *   The maximum number of characters a stored username may use.
 */
function icms_core_logic_username_max_length(): int {
  return UserInterface::USERNAME_MAX_LENGTH - 2;
}

/**
 * Builds the username ICMS stores for an email address.
 *
 * Shortening does not affect the acceptance criterion: email_registration
 * authenticates through user_load_by_mail(), so the full address still logs the
 * account in even when the stored username had to be shortened.
 *
 * @param string $mail
 *   The email address.
 *
 * @return string
 *   The username for that address.
 *
 * @see icms_core_logic_username_max_length()
 */
function icms_core_logic_username_for_mail(string $mail): string {
  $max = icms_core_logic_username_max_length();

  return mb_strlen($mail) > $max ? mb_substr($mail, 0, $max) : $mail;
}

/**
 * Implements hook_email_registration_name_alter().
 *
 * ICMS-714: a new account is named after its email address, and a username
 * that is the address follows the address when it changes. This is the single
 * place that decides it, and it runs last — icms_core_logic has weight 50,
 * email_registration has none — so whatever the contrib module derived from
 * the address (its local part) is replaced by the address itself. It applies
 * however the account is created: the registration form, /admin/people/create,
 * a migration, a seeding script or a client module — the name they pass is
 * overridden.
 *
 * Any other username is left alone. It predates this rule and is what its
 * owner has saved in their password manager, so it is never rewritten, not
 * even when the address changes. An older account whose username already is
 * its address is treated like a new one — the two are indistinguishable, and
 * its owner logs in with the address either way. Logging in works with either
 * value:
 * email_registration looks the address up first and falls back to the username
 * (email_registration.settings:login_with_username is on).
 *
 * Following the address matters for exactly the accounts this rule named: were
 * their username frozen at the first address, it would stay behind as a login
 * name that someone else's future address could match. Core's installer relies
 * on the same rule — it creates uid 1 as a placeholder whose name and address
 * are the same string, then saves the real ones over it, so uid 1 comes out
 * named after its address like every other account.
 *
 * Accounts without an address keep the name they were given: the anonymous
 * user, whose empty name is what makes getDisplayName() fall back to the
 * user.settings:anonymous label, and anything created without one.
 *
 * @see icms_core_logic_username_for_mail()
 * @see icms_core_logic_update_9059()
 */
function icms_core_logic_email_registration_name_alter(string &$newAccountName, UserInterface $account): void {
  $mail = (string) $account->getEmail();

  if ($mail === '') {
    return;
  }

  if (!$account->isNew()) {
    $original = $account->getOriginal();
    $previous = $original ? (string) $original->getEmail() : '';

    if ($previous === '' || $account->getAccountName() !== icms_core_logic_username_for_mail($previous)) {
      return;
    }
  }

  $newAccountName = icms_core_logic_username_for_mail($mail);
}

/**
 * Implements hook_theme_registry_alter().
 *
 * The redirect page of paragraphs_blokkli posts a message to the editor
 * without a target origin, which only reaches a same-origin parent. The
 * blökkli editor runs on the frontend domain, Drupal on its backend domain
 * (see docs/routing.md), so a template that delivers cross-origin is used.
 */
function icms_core_logic_theme_registry_alter(array &$theme_registry): void {
  if (!isset($theme_registry['paragraphs_blokkli_redirect'])) {
    return;
  }
  $theme_registry['paragraphs_blokkli_redirect']['path'] = \Drupal::service('extension.list.module')->getPath('icms_core_logic') . '/templates';
  $theme_registry['paragraphs_blokkli_redirect']['template'] = 'paragraphs-blokkli-redirect';
}

/**
 * Implements hook_library_info_alter().
 *
 * Same as the redirect template: the inline rich-text editor of
 * paragraphs_blokkli must post its updates to the cross-origin editor.
 */
function icms_core_logic_library_info_alter(array &$libraries, string $extension): void {
  if ($extension !== 'paragraphs_blokkli' || !isset($libraries['rich-text']['js']['js/rich-text.js'])) {
    return;
  }
  $path = '/' . \Drupal::service('extension.list.module')->getPath('icms_core_logic') . '/js/paragraphs-blokkli-rich-text.js';
  $libraries['rich-text']['js'] = [$path => $libraries['rich-text']['js']['js/rich-text.js']];
}

/**
 * Implements hook_theme().
 */
function icms_core_logic_theme(): array {
  return [
    'icms_site_shell' => [
      'variables' => ['url' => NULL, 'frontend_origin' => NULL],
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for nodes.
 *
 * On the backend domain, editors see a content page as the frontend renders
 * it, inside Drupal's navigation and top bar (see SiteShell).
 */
function icms_core_logic_node_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  _icms_core_logic_site_shell_view_alter($build, $entity, 'entity.node.canonical');
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for taxonomy terms.
 */
function icms_core_logic_taxonomy_term_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  _icms_core_logic_site_shell_view_alter($build, $entity, 'entity.taxonomy_term.canonical');
}

/**
 * Replaces a full entity view with the site shell on its canonical page.
 */
function _icms_core_logic_site_shell_view_alter(array &$build, EntityInterface $entity, string $canonical_route): void {
  if (($build['#view_mode'] ?? '') !== 'full' || \Drupal::routeMatch()->getRouteName() !== $canonical_route) {
    return;
  }
  $request = \Drupal::request();
  /** @var \Drupal\icms_core_logic\SiteShell $shell */
  $shell = \Drupal::service('icms_core_logic.site_shell');
  if (!$shell->applies($request)) {
    return;
  }
  $query = $request->getQueryString();
  // Keep what the render pipeline still reads from the entity build after
  // this hook (EntityViewController::buildTitle() needs #entity_type and the
  // entity), drop the theme hook and the fields: the shell is the content.
  $kept = ['#cache', '#attached', '#pre_render', '#entity_type', '#' . $entity->getEntityTypeId(), '#view_mode', '#weight'];
  $build = array_intersect_key($build, array_flip($kept)) + [
    'shell' => $shell->build($request, $entity->toUrl()->toString() . ($query ? '?' . $query : '')),
  ];
}

/**
 * Implements hook_entity_operation().
 *
 * "Edit page content" (blökkli) as the first (default) operation of
 * blökkli-enabled nodes in content listings.
 */
function icms_core_logic_entity_operation(EntityInterface $entity): array {
  if (!$entity instanceof NodeInterface || !\Drupal::service('icms_core_logic.blokkli_editor')->access($entity)->isAllowed()) {
    return [];
  }
  return [
    'blokkli' => [
      'title' => t('Edit page content'),
      'weight' => -10,
      'url' => Url::fromRoute('icms_core_logic.blokkli_edit', ['node' => $entity->id()]),
    ],
  ];
}

/**
 * Implements hook_entity_operation_alter().
 *
 * With the page content edited in blökkli, the node form is where the page's
 * settings live.
 */
function icms_core_logic_entity_operation_alter(array &$operations, EntityInterface $entity): void {
  if (isset($operations['edit']) && $entity instanceof NodeInterface && \Drupal::service('icms_core_logic.blokkli_editor')->isEnabled($entity)) {
    $operations['edit']['title'] = t('Page settings');
  }
}

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Same as the operations: on blökkli-enabled nodes the edit form tab is
 * "Page settings".
 */
function icms_core_logic_menu_local_tasks_alter(array &$data, string $route_name, RefinableCacheableDependencyInterface &$cacheability): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface || !isset($data['tabs'][0]['entity.node.edit_form'])) {
    return;
  }
  $cacheability->addCacheTags(['config:paragraphs_blokkli.settings']);
  if (\Drupal::service('icms_core_logic.blokkli_editor')->isEnabled($node)) {
    $data['tabs'][0]['entity.node.edit_form']['#link']['title'] = t('Page settings');
  }
}

/**
 * Implements hook_preprocess_HOOK() for the navigation top bar's page actions.
 *
 * Core features the entity's edit form as the primary action; on blökkli
 * pages the editor is the primary action and the edit form moves into the
 * "more actions" dropdown.
 */
function icms_core_logic_preprocess_top_bar_page_actions(array &$variables): void {
  foreach ($variables['page_actions'] as $key => $action) {
    if (!str_starts_with((string) $key, 'icms_core_logic.blokkli_edit')) {
      continue;
    }
    $demoted = array_map(static fn(array $featured) => $featured['page_action'], $variables['featured_page_actions'] ?? []);
    unset($variables['page_actions'][$key]);
    $variables['page_actions'] = $demoted + $variables['page_actions'];
    $variables['featured_page_actions'] = [
      $key => [
        'page_action' => $action,
        'icon' => ['pack_id' => 'icms_admin', 'icon_id' => 'blokkli'],
      ],
    ];
    return;
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Drupal pages on the backend domain leave the site shell if loaded inside
 * it (see js/frame-bust.js); blökkli's iframe pages are framed by the
 * frontend on purpose and stay out of it.
 */
function icms_core_logic_page_attachments(array &$attachments): void {
  $request = \Drupal::request();
  if (!\Drupal::service('icms_core_logic.backend_domain')->isBackendRequest($request)) {
    return;
  }
  $route_name = (string) \Drupal::routeMatch()->getRouteName();
  if ($request->query->get('paragraphsBlokkli') || str_starts_with($route_name, 'paragraphs_blokkli.')) {
    return;
  }
  $attachments['#attached']['library'][] = 'icms_core_logic/frame_bust';
}
